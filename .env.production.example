# ==============================================================================
# Plantilla de Variables de Entorno de Producción (12-Factor App)
# Sistema de Reservas Hoteleras Cloud-Native
# ==============================================================================
# INSTRUCCIÓN: Copia este archivo a '.env.production' en el servidor de despliegue
# y reemplaza los valores con las credenciales reales de tus servicios en AWS.
# NUNCA confirmes el archivo '.env.production' en Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de Datos Relacional (Amazon RDS PostgreSQL Multi-AZ)
# ------------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://hotel-rds-cluster.xyz.us-east-1.rds.amazonaws.com:5432/hotel_reservas_db
SPRING_DATASOURCE_USERNAME=hotel_admin
SPRING_DATASOURCE_PASSWORD=CambiarPorPasswordSeguroDeRDS!_2026
HIKARI_MAX_POOL_SIZE=20
HIKARI_MIN_IDLE=10

# ------------------------------------------------------------------------------
# 2. Caché en Memoria (Amazon ElastiCache Redis Cluster / Primary Endpoint)
# ------------------------------------------------------------------------------
SPRING_DATA_REDIS_HOST=hotel-redis-cluster.xyz.cache.amazonaws.com
SPRING_DATA_REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 3. Bus de Mensajería Cloud (Amazon SQS)
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1
# En producción en AWS, se usa el endpoint estándar de SQS de la región
AWS_SQS_ENDPOINT=https://sqs.us-east-1.amazonaws.com
SQS_RESERVATION_QUEUE_NAME=hotel-reservation-events-prod

# Credenciales IAM (Recomendación: En AWS EC2 / EKS utilizar IAM Instance Profiles / IRSA)
AWS_ACCESS_KEY_ID=AKIA_PRODUCTION_KEY_EXAMPLE
AWS_SECRET_ACCESS_KEY=PRODUCTION_SECRET_KEY_EXAMPLE

# ------------------------------------------------------------------------------
# 4. Parámetros de la JVM y Workload
# ------------------------------------------------------------------------------
JAVA_OPTS=-XX:+UseG1GC -XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError
PORT=8080

# ------------------------------------------------------------------------------
# 5. Observabilidad (Grafana y Prometheus)
# ------------------------------------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=GenerarPasswordSeguroGrafana2026!

